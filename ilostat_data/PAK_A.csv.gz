<style id='ilo-toc-widget-inline-inline-css'>

    .ilo-toc-widget { font-family: Arial, Helvetica, sans-serif; }
    .ilo-toc-widget ul { list-style:none; margin:0; padding:0; }
    .ilo-toc-widget li { margin:2px 0; } /* minimal spacing */

    .ilo-toc-widget a.ilo-toc-item{
        display:flex;
        align-items:center;
        justify-content:space-between;
        text-decoration:none;
        background:#EDF0F2;            /* default background */
        padding:16px 16px;
        border-radius:0;              /* square edges */
        color:#230050;                /* default text */
        transition: background .12s ease, color .12s ease, box-shadow .12s ease;
    }

    /* Hover: light blue background + text to ILO blue + thin blue lines */
    .ilo-toc-widget a.ilo-toc-item:hover{
        background:#ebf5fd;
        color:#1e2dbe;
        box-shadow: 0 3px 0 #1e2dbe, 0 2px 0 #1e2dbe; /* thin lines */
    }

    .ilo-toc-widget .ilo-toc-text{
        flex:1;
        margin-right:10px;
        line-height:1.25;
        font-size:15px;
        font-weight:500;
    }

    .ilo-toc-widget .ilo-toc-arrow{
        width:16px;
        height:16px;
        flex:0 0 16px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
    }
    .ilo-toc-widget .ilo-toc-arrow img{
        width:18px;
        height:18px;
        display:block;
    }
	
@media (min-width:1024px){
  .elementor-widget-ilo_toc_widget.ilo-toc-active{
    flex: 0 0 auto;
    min-width: 260px;
    max-width: 360px;
    width: 320px;
  }

  .elementor-widget-ilo_toc_widget:not(.ilo-toc-active){
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    max-width: none;
  }
}	
	
	/* Add gap to the container immediately after the TOC widget */
.elementor-widget-ilo_toc_widget.ilo-toc-active + *{
    margin-left:20px;
}

/* Only when sticky is active: constrain height + allow internal scroll */
.elementor-sticky--active .ilo-toc-widget{
  max-height: calc(100vh - 120px); /* adjust */
  overflow-y: auto;
  overflow-x: hidden;
}

/* When not sticky: no forced scrollbar */
.ilo-toc-widget{
  overflow: visible;
  max-height: none;
}
.elementor-widget-ilo_toc_widget.elementor-sticky--active{
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  overflow-x: hidden;
}
.elementor-widget-ilo_toc_widget{
  overflow: visible;
  max-height: none;
}	
    
/*# sourceURL=ilo-toc-widget-inline-inline-css */
</style>
