					<script>
				const lazyloadRunObserver = () => {
					const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
					const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
						entries.forEach( ( entry ) => {
							if ( entry.isIntersecting ) {
								let lazyloadBackground = entry.target;
								if( lazyloadBackground ) {
									lazyloadBackground.classList.add( 'e-lazyloaded' );
								}
								lazyloadBackgroundObserver.unobserve( entry.target );
							}
						});
					}, { rootMargin: '200px 0px 200px 0px' } );
					lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
						lazyloadBackgroundObserver.observe( lazyloadBackground );
					} );
				};
				const events = [
					'DOMContentLoaded',
					'elementor/lazyload/observe',
				];
				events.forEach( ( event ) => {
					document.addEventListener( event, lazyloadRunObserver );
				} );
			</script>
			<link rel='stylesheet' id='widget-posts-css' href='https://ilostat.ilo.org/wp-content/plugins/elementor-pro/assets/css/widget-posts.min.css?ver=3.35.1' media='all' />
<script id="ilo-toc-widget-inline-js-after">
(function(){
  function makeId(text, idx){
    return (text||'heading')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g,'-')
      .replace(/(^-|-$)/g,'');
  }

  function buildOne(root){
    if(!root || root.dataset.iloBuilt === '1') return;
    root.dataset.iloBuilt = '1';

    var levels = (root.getAttribute('data-levels') || '2')
      .split(',')
      .map(function(x){ return parseInt(x,10); })
      .filter(function(n){ return n>=1 && n<=6; });
    if(!levels.length) levels = [2];

    var containerSel = root.getAttribute('data-container') || 'body';
    var iconUrl = root.getAttribute('data-icon') || '';
    var minitems = parseInt(root.getAttribute('data-minitems') || '1', 10);
    if(!isFinite(minitems) || minitems < 0) minitems = 1;

    var container = document.querySelector(containerSel) || document.body;
    var sel = levels.map(function(l){ return 'h'+l; }).join(',');
    var nodes = Array.prototype.slice.call(container.querySelectorAll(sel)).filter(function(n){
      return !n.closest('.elementor-location-header') &&
             !n.closest('.elementor-location-footer');
    });

    var listWrap = root.querySelector('.ilo-toc-list');
    if(!listWrap) return;

var wrapper = root.closest('.elementor-widget-ilo_toc_widget');

/* Hide widget if not enough items */
if(nodes.length < minitems){
  root.style.display = 'none';
  if(wrapper) wrapper.classList.remove('ilo-toc-active');
  return;
}

root.style.display = '';
if(wrapper) wrapper.classList.add('ilo-toc-active');

    // Build flat list for consistent alignment
    var ul = document.createElement('ul');

    nodes.forEach(function(n, i){
      var text = (n.textContent || '').trim();
      var id = n.id || makeId(text);
      if(!n.id) n.id = id;

      var li = document.createElement('li');

      var a = document.createElement('a');
      a.className = 'ilo-toc-item';
      a.href = '#'+id;
      a.setAttribute('data-target', id);

      var t = document.createElement('span');
      t.className = 'ilo-toc-text';
      t.textContent = text || '(no text)';

      var ar = document.createElement('span');
      ar.className = 'ilo-toc-arrow';
      if(iconUrl){
        var img = document.createElement('img');
        img.src = iconUrl;
        img.alt = '';
        ar.appendChild(img);
      }

      a.appendChild(t);
      a.appendChild(ar);
      li.appendChild(a);
      ul.appendChild(li);
    });

    listWrap.innerHTML = '';
    listWrap.appendChild(ul);

    // Smooth scroll (simple, always on)
    listWrap.addEventListener('click', function(e){
      var a = e.target.closest('a[data-target]');
      if(!a) return;
      e.preventDefault();
      var id = a.getAttribute('data-target');
      var dest = document.getElementById(id);
      if(!dest) return;
      if(dest.scrollIntoView) dest.scrollIntoView({behavior:'smooth'});
      if(history.replaceState) history.replaceState(null,null,'#'+id);
    });
  }

  function buildAll(){
    document.querySelectorAll('.ilo-toc-widget[data-ilo-toc]').forEach(buildOne);
  }

  // Frontend
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildAll);
  else buildAll();

  // Elementor editor preview
  if(window.elementorFrontend && window.elementorFrontend.hooks){
    window.elementorFrontend.hooks.addAction('frontend/element_ready/global', buildAll);
  }
})();
